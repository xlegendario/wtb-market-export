# --- Airtable ---
AIRTABLE_TOKEN=pat...
AIRTABLE_BASE_ID=app...
AIRTABLE_ORDERS_TABLE=Unfulfilled Orders Log

# --- WTB Market Users API ---
WTB_API_BASE_URL=https://api.wtbmarket.eu
WTB_API_KEY=
WTB_API_KEY_HEADER=key
WTB_USER_ID=            # jouw Discord ID
# 2000ms = 30 requests/min. Bij 250ms liep de eerste productierun tegen een
# rate limit aan. Na een 429 verdubbelt de service dit vanzelf voor de rest van de run.
WTB_REQUEST_DELAY_MS=2000
WTB_MAX_REQUEST_DELAY_MS=10000
WTB_RATE_LIMIT_BACKOFF_MS=15000
WTB_MAX_RETRIES=4
WTB_TIMEOUT_MS=15000

# raw = Size letterlijk doorsturen (default) | eu = 41 1/3 -> 41 | dewu = als Airtable's Dewu Size Normalized
WTB_SIZE_MODE=raw

# Profielen die ook mogen opruimen (maten van de lijst halen die niet meer gewenst zijn).
# Leeg = nooit verwijderen. Bijv: WTB_PRUNE_PROFILES=rotating

# Vangnet: prunen wordt overgeslagen als Airtable 0 items teruggeeft terwijl er
# wel items op de WTB-lijst staan. Zet op true als je bewust alles wilt wissen.
WTB_ALLOW_EMPTY_PRUNE=falseall-open
WTB_PRUNE_PROFILES=rotating

# Vangnet: prunen wordt overgeslagen als Airtable 0 items teruggeeft terwijl er
# wel items op de WTB-lijst staan. Zet op true als je bewust alles wilt wissen.
WTB_ALLOW_EMPTY_PRUNE=false

WTB_HIGH_VALUE_MIN=150

# --- profiel: rotating ---
# Rotatie op {Created Time}, in uren: 0-48 erin, 48-72 eruit, 72-96 weer erin.
WTB_WINDOW_A_END=48
WTB_WINDOW_B_START=72
WTB_WINDOW_B_END=96
# Store die nooit meegaat. Leeg = geen enkele store uitsluiten.
WTB_EXCLUDE_STORE=SneakerAsk

# --- Runs ---
# Render Cron Job (`run-profile.js --today`): welke filter op welke dag.
# Zonder entry voor vandaag doet de run niets. `default=` vangt de rest op.
WTB_DAILY_PROFILES=default=rotating

# Zomertijd-vangnet: draai alleen als het lokaal dit uur is (0-23).
# Cron staat op beide kandidaat-UTC-tijden; hiermee valt de juiste eruit.
# Leeg = geen tijdslot-check.
WTB_RUN_LOCAL_HOUR=12

# Alleen voor de long-running server (`npm start`): "<cron>|<profiel>" gescheiden door ;
WTB_SCHEDULE=
TZ=Europe/Amsterdam

RUN_SECRET=verzin-iets-lang
DRY_RUN=false
PORT=10000
